# ==========================================
# Videogame Tracker - environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# --- Docker Compose / PostgreSQL ---
DB_NAME=videogame_tracker
DB_USER=videogame_tracker_app
DB_PASSWORD=123456
DB_PORT=5432

# --- Spring Boot (datasource) ---
# Local: API running on the host, database in Docker
DB_URL=jdbc:postgresql://localhost:5432/videogame_tracker
# Inside the Compose network the host is the service name:
# DB_URL=jdbc:postgresql://db:5432/videogame_tracker

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Security (JWT) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_with_a_long_random_value
JWT_EXPIRATION_MINUTES=60

# --- External integrations (future) ---
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# RAWG_API_KEY=
